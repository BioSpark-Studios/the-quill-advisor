# Provider API keys for the Omni-Route AI router.
# Copy to `.env` and fill in the providers you want to use.
# Ollama needs no key (local, default offline provider).

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: point at a non-default Ollama host.
OLLAMA_BASE_URL=http://localhost:11434
